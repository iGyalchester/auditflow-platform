<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.auditflow</groupId>
  <artifactId>auditflow-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>AuditFlow Platform</name>
  <description>Continuous compliance monitoring platform</description>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.3.2</spring-boot.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <!-- The console (frontend/) is bundled into the gateway jar by the
         "frontend" profile in services/api-gateway-service/pom.xml. -->
    <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
    <node.version>v22.12.0</node.version>
  </properties>

  <modules>
    <module>shared/common-lib</module>
    <module>services/ingestion-service</module>
    <module>services/enrichment-service</module>
    <module>services/alerting-service</module>
    <module>services/api-gateway-service</module>
    <module>agent/collector-agent</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.auditflow</groupId>
        <artifactId>common-lib</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
          <!-- This build imports Spring Boot as a BOM rather than using
               spring-boot-starter-parent, and only the parent wires the
               repackage goal in for you. Without this execution "mvn package"
               leaves a plain jar with no Main-Class, and every image fails
               with "no main manifest attribute". -->
          <executions>
            <execution>
              <goals>
                <goal>repackage</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <systemPropertyVariables>
              <!-- Docker Engine 29+ rejects the older API version docker-java
                   negotiates by default (HTTP 400 on the named pipe), which
                   silently skips the Testcontainers integration tests. Pinning
                   the client API version keeps them running; 1.44 is Engine
                   29's minimum and is supported by Engine 25+. -->
              <api.version>1.44</api.version>
            </systemPropertyVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
