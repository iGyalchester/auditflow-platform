<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.auditflow</groupId>
  <artifactId>auditflow-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>AuditFlow Platform</name>
  <description>Continuous compliance monitoring platform</description>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Spring MVC infers @RequestParam/@PathVariable names via reflection,
         which needs javac -parameters; without spring-boot-starter-parent
         (this build uses a custom parent) nothing enables it by default. -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <spring-boot.version>3.3.2</spring-boot.version>
    <testcontainers.version>2.0.5</testcontainers.version>
  </properties>

  <modules>
    <module>shared/common-lib</module>
    <module>services/ingestion-service</module>
    <module>services/enrichment-service</module>
    <module>services/alerting-service</module>
    <module>services/reporting-service</module>
    <module>services/api-gateway-service</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.auditflow</groupId>
        <artifactId>common-lib</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- Docker Engine 29+ rejects the older API version docker-java
                 negotiates by default (HTTP 400 on the named pipe), which
                 silently skips the Testcontainers integration tests. Pinning
                 the client API version keeps them running; 1.44 is Engine
                 29's minimum and is supported by Engine 25+.
                 Must be an argLine -D (present at JVM startup), not
                 systemPropertyVariables: the latter is set too late for
                 docker-java's transport negotiation and the tests skip. -->
            <argLine>-Dapi.version=1.44</argLine>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
